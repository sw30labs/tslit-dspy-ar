# TSLIT-DSPy environment configuration
# Copy to .env and fill in values

# --- Anthropic API (required for R&D: compilation + inference) ---
ANTHROPIC_API_KEY="sk-ant-..."

# --- OpenAI API (optional, alternative compilation model) ---
OPENAI_API_KEY="sk-..."

# --- Ollama (optional, for local deployment validation with GPT-OSS-120) ---
# Ollama runs on http://localhost:11434 by default — no config needed
# Set the model in experiment_config.json under "inference_model"

# --- Legacy: Local MLX server (retained for backward compatibility) ---
# USE_LOCAL_MLX="false"
# MLX_COMPILE_URL="http://localhost:8080/v1"
# MLX_INFERENCE_URL="http://localhost:8081/v1"
